# Offline variant of the product image.
#
# The executor recipe builds with `--network none`, so this variant resolves
# every dependency from artifacts that are already local: the runtime base
# carries the Debian runtime, the wheelhouse base carries the locked wheels.
# No step in this file reaches the network, which is the property
# `tests/test_offline_build_contract.py` enforces.
#
# The two base images are built once with network access and pinned here by
# digest:
#
#   docker build -f docker/offline-runtime.Dockerfile \
#     --build-arg DEBIAN_SNAPSHOT=20261020T000000Z -t percival-notes-runtime:offline-base .
#   docker build -f docker/offline-wheelhouse.Dockerfile \
#     --build-arg WHEELHOUSE_MANIFEST=vendor/wheelhouse-manifest.json \
#     -t percival-notes-wheelhouse:offline-base .
#
# The two base images are local bases of this project, built and scanned by
# the executor and referenced by the literal `localReference` it published for
# each producer job:
#
#   runtime base      job bbda217d0100c6163b5fda3e0359135809e9c30ea59773504f0f056f9bc675c9
#                     imageId sha256:acd98ac4...  configDigest sha256:5392929f...
#                     0 findings at the [HIGH, CRITICAL] gate
#   wheelhouse base   job fd234fc2fce4cb3d505f73a3a270e3e72bf9a25a16d5bb2bcefb44aa79a6bf00
#                     imageId sha256:6b121102...  configDigest sha256:df0b02cf...
#                     0 findings at the [HIGH, CRITICAL] gate
#
# The producer jobs are declared in the project policy (`localBases`) and the
# executor verifies identity, scan gate and platform before the build starts.
# The literals below change whenever a base is rebuilt; they are the only
# references the local-base mode accepts, and they are immutable.
#
# Switching the executor recipe to this file is an owner decision: the recipe
# still points at the networked `Dockerfile` until that decision is taken.
#
# The result is equivalent to the networked `Dockerfile`: same Debian runtime,
# same locked Python dependencies, same non-root user, same entrypoint.

FROM docker.io/positronic-build/e3c0ebddd73c4cdd0650740249dcca7429cf40d7bfa225cc56be1fd5d7b8b7a0:fd234fc2fce4cb3d505f73a3a270e3e72bf9a25a16d5bb2bcefb44aa79a6bf00@sha256:6b121102248681eb12761956d4efc87e5f7a3b65e951d9d1bd4e5db9a6d3a58c AS builder

ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock notes_mcp.py README.md LICENSE ./
COPY scripts/offline-wheelhouse.py /app/scripts/offline-wheelhouse.py
COPY vendor/wheelhouse-manifest.json /wheels/manifest.json
RUN python3 /app/scripts/offline-wheelhouse.py verify \
        --manifest /wheels/manifest.json --wheelhouse /wheels
RUN python3 -m venv /opt/buildvenv \
    && /opt/buildvenv/bin/pip install --no-cache-dir --no-index --find-links /wheels \
        --require-hashes --no-deps -r /wheels/build-requirements.txt \
    && /opt/buildvenv/bin/pip wheel --no-deps --no-build-isolation --wheel-dir /wheels/project . \
    && python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --no-index \
        --find-links /wheels --find-links /wheels/project percival-notes-mcp

FROM docker.io/positronic-build/e3c0ebddd73c4cdd0650740249dcca7429cf40d7bfa225cc56be1fd5d7b8b7a0:bbda217d0100c6163b5fda3e0359135809e9c30ea59773504f0f056f9bc675c9@sha256:acd98ac4e2e9309526b05125ab4f73776e29e981c282315928091662cde5fd67 AS runtime

ARG VERSION=0.0.0
ARG GIT_SHA=unknown

LABEL org.opencontainers.image.title="Percival Notes MCP" \
      org.opencontainers.image.description="MCP server for OKF v0.2 markdown notes and ripgrep search" \
      org.opencontainers.image.source="https://github.com/bill-kopp-ai-dev/percival-notes-mcp" \
      org.opencontainers.image.documentation="https://github.com/bill-kopp-ai-dev/percival-notes-mcp/blob/main/README.md" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Positronic Bean Labs" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${GIT_SHA}"

ENV PATH=/opt/venv/bin:$PATH \
    HOME=/tmp \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

COPY --from=builder /usr/local/bin/python3.12 /usr/local/bin/python3.12
COPY --from=builder /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=builder /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/libpython3.12.so.1.0
COPY --from=builder /opt/venv /opt/venv
COPY docker_entrypoint.py LICENSE /app/
RUN ln -sf /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/libpython3.12.so \
    && ln -sf /usr/local/bin/python3.12 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/python3.12 /usr/local/bin/python \
    && chmod 0644 /app/docker_entrypoint.py /app/LICENSE \
    && mkdir -p /vault /app \
    && chmod 0755 /app \
    && chown 65532:65532 /vault \
    && chmod 0750 /vault
USER 65532:65532
WORKDIR /app
ENTRYPOINT ["python", "/app/docker_entrypoint.py"]
