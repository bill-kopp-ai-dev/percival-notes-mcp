# Wheelhouse base for the offline image build.
#
# Built ONCE with network access by the operator, then pinned by digest and
# consumed by `Dockerfile.offline`. It carries the exact wheels that the lock
# files pin for linux/amd64 and CPython 3.12, plus the build backend needed to
# turn the product source into a wheel. Nothing here reaches the network when
# the product is built: the product build only reads from this image.
#
# The wheel set is derived from `vendor/wheelhouse-manifest.json`, generated by
# `scripts/offline-wheelhouse.py plan`. Every artifact is verified against the
# hash recorded in the manifest before it is stored, and the manifest itself is
# verified against `uv.lock` and `uv-bootstrap-requirements.lock` by
# `tests/test_offline_build_contract.py`.
#
# Build with network access:
#   docker build -f docker/offline-wheelhouse.Dockerfile \
#     --build-arg WHEELHOUSE_MANIFEST=vendor/wheelhouse-manifest.json \
#     -t percival-notes-wheelhouse:offline-base .
#
# Keep the build log and the digest: they are part of the image provenance
# recorded in the F3 evidence.

FROM python:3.12-slim-trixie@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe

ARG WHEELHOUSE_MANIFEST=vendor/wheelhouse-manifest.json
LABEL org.opencontainers.image.title="Percival Notes MCP wheelhouse base" \
      org.opencontainers.image.description="Locked wheels for the offline Notes image build" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Positronic Bean Labs" \
      org.opencontainers.image.version="1" \
      org.opencontainers.image.revision="unknown"

COPY ${WHEELHOUSE_MANIFEST} /wheels/manifest.json
RUN python3 -c '
import hashlib, json, pathlib, urllib.request

manifest = json.loads(pathlib.Path("/wheels/manifest.json").read_text())
wheels = pathlib.Path("/wheels")
requirements = []
for entry in [*manifest["bootstrap"], *manifest["runtime"], *manifest.get("build", [])]:
    data = urllib.request.urlopen(entry["url"], timeout=120).read()
    digest = hashlib.sha256(data).hexdigest()
    if digest != entry["sha256"]:
        raise SystemExit("hash mismatch for " + entry["filename"])
    (wheels / entry["filename"]).write_bytes(data)
    requirements.append(
        entry["name"] + "==" + entry["version"] + " --hash=sha256:" + entry["sha256"]
    )
pathlib.Path("/wheels/requirements.txt").write_text("\n".join(requirements) + "\n")
print("stored", len(requirements), "wheels")
'
