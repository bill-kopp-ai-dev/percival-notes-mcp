# Wheelhouse base for the offline image build.
#
# Built ONCE with network access by the operator, then pinned by digest and
# consumed by `Dockerfile.offline`. It carries the exact wheels that the lock
# files pin for linux/amd64 and CPython 3.12, plus the build backend needed to
# turn the product source into a wheel. Nothing here reaches the network when
# the product is built: the product build only reads from this image.
#
# The wheel set is derived from `vendor/wheelhouse-manifest.json`, generated by
# `scripts/offline-wheelhouse.py plan`. Every artifact is verified against the
# hash recorded in the manifest before it is stored, and the manifest itself is
# verified against `uv.lock` and `uv-bootstrap-requirements.lock` by
# `tests/test_offline_build_contract.py`.
#
# The base is the hardened runtime base (Debian forky, every package pinned to
# a dated snapshot, no package manager and no setuid bits) plus the CPython
# runtime, exactly like the product's runtime stage. Building it on top of the
# raw `python:3.12-slim-trixie` image instead would import that release's
# Debian packages, and the executor's blocking scan gate rejects the image:
# the trixie base carries 51 HIGH/CRITICAL findings, the forky runtime none.
#
# The runtime base is a local base of this project, so it is referenced by the
# literal `localReference` the executor published for its producer job
# (producer job `bbda217d0100c6163b5fda3e0359135809e9c30ea59773504f0f056f9bc675c9`,
# `imageResolution: verified`, 0 findings at the blocking gate). The literal
# changes whenever the runtime base is rebuilt; the producer job is declared in
# the project policy (`localBases`) and the executor verifies identity, gate
# and platform before the build starts.
#
# Build with network access:
#   docker build -f docker/offline-wheelhouse.Dockerfile \
#     --build-arg WHEELHOUSE_MANIFEST=vendor/wheelhouse-manifest.json \
#     -t percival-notes-wheelhouse:offline-base .
#
# Keep the build log and the digest: they are part of the image provenance
# recorded in the F3 evidence.

FROM python:3.12-slim-trixie@sha256:2b4f19dae3a777dfc3b76730bda1e82e1f66ab2a2686fa93ca78edbfb4f04ffe AS python-runtime

FROM docker.io/positronic-build/e3c0ebddd73c4cdd0650740249dcca7429cf40d7bfa225cc56be1fd5d7b8b7a0:bbda217d0100c6163b5fda3e0359135809e9c30ea59773504f0f056f9bc675c9@sha256:acd98ac4e2e9309526b05125ab4f73776e29e981c282315928091662cde5fd67

ARG WHEELHOUSE_MANIFEST=vendor/wheelhouse-manifest.json
LABEL org.opencontainers.image.title="Percival Notes MCP wheelhouse base" \
      org.opencontainers.image.description="Locked wheels for the offline Notes image build" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.vendor="Positronic Bean Labs" \
      org.opencontainers.image.version="1" \
      org.opencontainers.image.revision="unknown"

COPY --from=python-runtime /usr/local/bin/python3.12 /usr/local/bin/python3.12
COPY --from=python-runtime /usr/local/lib/python3.12 /usr/local/lib/python3.12
COPY --from=python-runtime /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/libpython3.12.so.1.0
RUN ln -sf /usr/local/lib/libpython3.12.so.1.0 /usr/local/lib/libpython3.12.so \
    && ln -sf /usr/local/bin/python3.12 /usr/local/bin/python3 \
    && ln -sf /usr/local/bin/python3.12 /usr/local/bin/python

COPY vendor/wheelhouse-manifest.json /wheels/manifest.json
COPY docker/offline-wheelhouse-fetch.py /wheels/fetch.py
RUN python3 /wheels/fetch.py
